# Briefcase configuration (all optional). Copy to .env and edit as needed.

# ---- Answer engine ----
# auto (default) picks gemini -> ollama -> extractive fallback.
# Force one with: gemini | ollama | extractive
BRIEFCASE_LLM=auto

# Gemini (for synthesized answers). Get a key at https://aistudio.google.com/apikey
# You can also set the key in the in-app Settings panel instead of here.
# GEMINI_API_KEY=your-key-here
# BRIEFCASE_GEMINI_MODEL=gemini-2.5-flash   # if your key has no quota for a model, try this one

# Ollama (local models). Install from https://ollama.com then: ollama pull llama3.2
# BRIEFCASE_OLLAMA_MODEL=llama3.2
# BRIEFCASE_OLLAMA_URL=http://localhost:11434

# ---- Embeddings ----
# hashing (default, zero deps) | sentence-transformers | gemini
BRIEFCASE_EMBEDDINGS=hashing

# ---- OCR (scanned / image-only PDFs and image files) ----
# auto (use OCR when installed) | off
# Install the engine with:  pip install rapidocr-onnxruntime pdf2image
BRIEFCASE_OCR=auto

# ---- Storage / server ----
# BRIEFCASE_DATA_DIR=./data
# BRIEFCASE_HOST=127.0.0.1
# BRIEFCASE_PORT=8000
